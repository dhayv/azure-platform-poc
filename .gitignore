# Local .terraform directory (cached plugins and modules)
.terraform/

# .tfstate files (Contains sensitive data and infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files by default (contain secrets/local variables)
*.tfvars
*.tfvars.json

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exclude CLI configuration files
.terraformrc
terraform.rc

# Personal project notes — local only
PROJECT_NOTES.md

# Python
__pycache__/
*.pyc
.venv/
